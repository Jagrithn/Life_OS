# Supabase project connection (Project Settings → API in the Supabase dashboard).
# Copy this file to .env and fill in the values for your own project.
SUPABASE_PROJECT_ID="your-project-ref"
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-publishable-or-anon-key"

# Exposed to the browser at build time (same values, VITE_ prefix).
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-or-anon-key"

# Server-only, never expose to the browser (used by server-side admin helpers).
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
